@page
@model DetallesComprasModel
@{
    ViewData["Title"] = "Detalles de compras";
}
<form method="post">

    <div class="text-center">
        <h1 class="display-4">Detalles de compras</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar" />
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo" />
            @if (Model.Nuevo)
            {
                <input type="submit"
                    value="Guardar"
                    class="btn btn-primary"
                    asp-page-handler="BtGuardar" />
                <input type="submit"
                    value="Cancelar"
                    class="btn btn-outline-secondary"
                    asp-page-handler="BtCancelar" />
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") mt-3">@Model.Mensaje</div>
    }

    @if (Model.Nuevo && Model.Actual != null)
    {
        <div class="mt-3">
            <h3>Detalle de compra</h3>
            <input type="hidden" asp-for="@Model.Actual!.Id" />

                <div class="mb-3">
                    <label class="form-label">Precio Compra</label>
                    <input asp-for="@Model.Actual!.PrecioCompra" type="number" step="any" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Cantidad</label>
                    <input asp-for="@Model.Actual!.Cantidad" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Producto (Id)</label>
                    <input asp-for="@Model.Actual!.Producto" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Compra Proveedor (Id)</label>
                    <input asp-for="@Model.Actual!.CompraProveedor" type="number" class="form-control" />
                </div>
        </div>
    }

    @if (!Model.Nuevo)
    {
        <div class="containers_vn panel panel-default mt-4">
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>Id</th>
                    <th>Precio Compra</th>
                    <th>Cantidad</th>
                    <th>Producto (Id)</th>
                    <th>Compra Proveedor (Id)</th>
                    <th></th>
                </tr>
                @if (Model.Lista != null)
                {
                    foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Id</td>
                            <td>@elemento.PrecioCompra</td>
                            <td>@elemento.Cantidad</td>
                            <td>@elemento.Producto</td>
                            <td>@elemento.CompraProveedor</td>
                            <td>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-primary"
                                    asp-page-handler="BtModificar"
                                    asp-route-id="@elemento.Id">Modificar</button>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    asp-page-handler="BtBorrar"
                                    asp-route-id="@elemento.Id"
                                    onclick="return confirm('¿Borrar este registro?');">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    }

</form>
