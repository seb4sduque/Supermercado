@page
@model InventariosModel
@{
    ViewData["Title"] = "Inventarios";
}
<form method="post">

    <div class="text-center">
        <h1 class="display-4">Inventarios</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar" />
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo" />
            @if (Model.Nuevo)
            {
                <input type="submit"
                    value="Guardar"
                    class="btn btn-primary"
                    asp-page-handler="BtGuardar" />
                <input type="submit"
                    value="Cancelar"
                    class="btn btn-outline-secondary"
                    asp-page-handler="BtCancelar" />
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") mt-3">@Model.Mensaje</div>
    }

    @if (Model.Nuevo && Model.Actual != null)
    {
        <div class="mt-3">
            <h3>Inventario</h3>
            <input type="hidden" asp-for="@Model.Actual!.Id" />

                <div class="mb-3">
                    <label class="form-label">Stock</label>
                    <input asp-for="@Model.Actual!.Stock" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Stock Minimo</label>
                    <input asp-for="@Model.Actual!.StockMinimo" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Producto (Id)</label>
                    <input asp-for="@Model.Actual!.Producto" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Bodega (Id)</label>
                    <input asp-for="@Model.Actual!.Bodega" type="number" class="form-control" />
                </div>
        </div>
    }

    @if (!Model.Nuevo)
    {
        <div class="containers_vn panel panel-default mt-4">
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>Id</th>
                    <th>Stock</th>
                    <th>Stock Minimo</th>
                    <th>Producto (Id)</th>
                    <th>Bodega (Id)</th>
                    <th></th>
                </tr>
                @if (Model.Lista != null)
                {
                    foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Id</td>
                            <td>@elemento.Stock</td>
                            <td>@elemento.StockMinimo</td>
                            <td>@elemento.Producto</td>
                            <td>@elemento.Bodega</td>
                            <td>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-primary"
                                    asp-page-handler="BtModificar"
                                    asp-route-id="@elemento.Id">Modificar</button>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    asp-page-handler="BtBorrar"
                                    asp-route-id="@elemento.Id"
                                    onclick="return confirm('¿Borrar este registro?');">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    }

</form>
