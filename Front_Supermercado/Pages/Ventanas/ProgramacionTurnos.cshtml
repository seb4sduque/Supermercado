@page
@model ProgramacionTurnosModel
@{
    ViewData["Title"] = "Programación de turnos";
}
<form method="post">

    <div class="text-center">
        <h1 class="display-4">Programación de turnos</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar" />
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo" />
            @if (Model.Nuevo)
            {
                <input type="submit"
                    value="Guardar"
                    class="btn btn-primary"
                    asp-page-handler="BtGuardar" />
                <input type="submit"
                    value="Cancelar"
                    class="btn btn-outline-secondary"
                    asp-page-handler="BtCancelar" />
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") mt-3">@Model.Mensaje</div>
    }

    @if (Model.Nuevo && Model.Actual != null)
    {
        <div class="mt-3">
            <h3>Programación de turno</h3>
            <input type="hidden" asp-for="@Model.Actual!.Id" />

                <div class="mb-3">
                    <label class="form-label">Fecha Asignacion</label>
                    <input asp-for="@Model.Actual!.FechaAsignacion" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Horas Extras</label>
                    <input asp-for="@Model.Actual!.HorasExtras" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Empleado</label>
                    <select asp-for="@Model.Actual!.Empleado" asp-items="Model.OpcionesEmpleado" class="form-select">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Turno</label>
                    <select asp-for="@Model.Actual!.Turno" asp-items="Model.OpcionesTurno" class="form-select">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
        </div>
    }

    @if (!Model.Nuevo)
    {
        <div class="containers_vn panel panel-default mt-4">
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>Fecha Asignacion</th>
                    <th>Horas Extras</th>
                    <th>Empleado</th>
                    <th>Turno</th>
                    <th></th>
                </tr>
                @if (Model.Lista != null)
                {
                    foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.FechaAsignacion.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@elemento.HorasExtras</td>
                            <td>@Model.NombreEmpleado.GetValueOrDefault(elemento.Empleado)</td>
                            <td>@Model.NombreTurno.GetValueOrDefault(elemento.Turno)</td>
                            <td>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-primary"
                                    asp-page-handler="BtModificar"
                                    asp-route-id="@elemento.Id">Modificar</button>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    asp-page-handler="BtBorrar"
                                    asp-route-id="@elemento.Id"
                                    onclick="return confirm('¿Borrar este registro?');">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    }

</form>
