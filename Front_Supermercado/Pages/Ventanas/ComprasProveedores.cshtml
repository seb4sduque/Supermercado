@page
@model ComprasProveedoresModel
@{
    ViewData["Title"] = "Compras a proveedores";
}
<form method="post">

    <div class="text-center">
        <h1 class="display-4">Compras a proveedores</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar" />
            @if (Model.PuedeCrear)
            {
                <input type="submit"
                    value="Nuevo"
                    class="btn btn-secondary"
                    asp-page-handler="BtNuevo" />
            }
            @if (Model.Nuevo)
            {
                <input type="submit"
                    value="Guardar"
                    class="btn btn-primary"
                    asp-page-handler="BtGuardar" />
                <input type="submit"
                    value="Cancelar"
                    class="btn btn-outline-secondary"
                    asp-page-handler="BtCancelar" />
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") mt-3">@Model.Mensaje</div>
    }

    @if (Model.Nuevo && Model.Actual != null)
    {
        <div class="mt-3">
            <h3>Compra a proveedor</h3>
            <input type="hidden" asp-for="@Model.Actual!.Id" />

                <div class="mb-3">
                    <label class="form-label">Numero Factura</label>
                    <input asp-for="@Model.Actual!.NumeroFactura" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Fecha Compra</label>
                    <input asp-for="@Model.Actual!.FechaCompra" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Total Compra</label>
                    <input asp-for="@Model.Actual!.TotalCompra" type="number" step="any" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Proveedor</label>
                    <select asp-for="@Model.Actual!.Proveedor" asp-items="Model.OpcionesProveedor" class="form-select">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
        </div>
    }

    @if (!Model.Nuevo)
    {
        <div class="containers_vn panel panel-default mt-4">
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>Numero Factura</th>
                    <th>Fecha Compra</th>
                    <th>Total Compra</th>
                    <th>Proveedor</th>
                    <th></th>
                </tr>
                @if (Model.Lista != null)
                {
                    foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.NumeroFactura</td>
                            <td>@elemento.FechaCompra.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@elemento.TotalCompra</td>
                            <td>@Model.NombreProveedor.GetValueOrDefault(elemento.Proveedor)</td>
                            <td>
                                @if (Model.PuedeModificar)
                                {
                                    <button type="submit"
                                        class="btn btn-sm btn-outline-primary"
                                        asp-page-handler="BtModificar"
                                        asp-route-id="@elemento.Id">Modificar</button>
                                }
                                @if (Model.PuedeBorrar)
                                {
                                    <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        asp-page-handler="BtBorrar"
                                        asp-route-id="@elemento.Id"
                                        onclick="return confirm('¿Borrar este registro?');">Borrar</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    }

</form>
