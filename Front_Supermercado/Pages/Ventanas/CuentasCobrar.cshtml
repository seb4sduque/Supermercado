@page
@model CuentasCobrarModel
@{
    ViewData["Title"] = "Cuentas por cobrar";
}
<form method="post">

    <div class="text-center">
        <h1 class="display-4">Cuentas por cobrar</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar" />
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo" />
            @if (Model.Nuevo)
            {
                <input type="submit"
                    value="Guardar"
                    class="btn btn-primary"
                    asp-page-handler="BtGuardar" />
                <input type="submit"
                    value="Cancelar"
                    class="btn btn-outline-secondary"
                    asp-page-handler="BtCancelar" />
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") mt-3">@Model.Mensaje</div>
    }

    @if (Model.Nuevo && Model.Actual != null)
    {
        <div class="mt-3">
            <h3>Cuenta por cobrar</h3>
            <input type="hidden" asp-for="@Model.Actual!.Id" />

                <div class="mb-3">
                    <label class="form-label">Saldo Pendiente</label>
                    <input asp-for="@Model.Actual!.SaldoPendiente" type="number" step="any" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Estado Deuda</label>
                    <input asp-for="@Model.Actual!.EstadoDeuda" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Cliente</label>
                    <select asp-for="@Model.Actual!.Cliente" asp-items="Model.OpcionesCliente" class="form-select">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Factura</label>
                    <select asp-for="@Model.Actual!.Factura" asp-items="Model.OpcionesFactura" class="form-select">
                        <option value="0">-- Seleccione --</option>
                    </select>
                </div>
        </div>
    }

    @if (!Model.Nuevo)
    {
        <div class="containers_vn panel panel-default mt-4">
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>Saldo Pendiente</th>
                    <th>Estado Deuda</th>
                    <th>Cliente</th>
                    <th>Factura</th>
                    <th></th>
                </tr>
                @if (Model.Lista != null)
                {
                    foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.SaldoPendiente</td>
                            <td>@elemento.EstadoDeuda</td>
                            <td>@Model.NombreCliente.GetValueOrDefault(elemento.Cliente)</td>
                            <td>@Model.NombreFactura.GetValueOrDefault(elemento.Factura)</td>
                            <td>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-primary"
                                    asp-page-handler="BtModificar"
                                    asp-route-id="@elemento.Id">Modificar</button>
                                <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    asp-page-handler="BtBorrar"
                                    asp-route-id="@elemento.Id"
                                    onclick="return confirm('¿Borrar este registro?');">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    }

</form>
