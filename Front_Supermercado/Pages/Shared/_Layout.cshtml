<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Front_Supermercado</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Front_Supermercado.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Front_Supermercado</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Personas</a>
                            <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Personas">Personas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Clientes">Clientes</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Proveedores">Proveedores</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Empleados</a>
                            <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Empleados">Empleados</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Cargos">Cargos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Turnos">Turnos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/ProgramacionTurnos">Programación de turnos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/SueldoEmpleados">Sueldos de empleados</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Productos</a>
                            <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Categorias">Categorías</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Subcategorias">Subcategorías</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Productos">Productos</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Inventario</a>
                            <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Bodegas">Bodegas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Inventarios">Inventarios</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/MovimientosInventarios">Movimientos de inventarios</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Ventas</a>
                            <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Facturas">Facturas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/DetallesFacturas">Detalles de facturas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/MetodosPago">Métodos de pago</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/CuentasCobrar">Cuentas por cobrar</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Compras</a>
                            <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/ComprasProveedores">Compras a proveedores</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/DetallesCompras">Detalles de compras</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Front_Supermercado - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
